# Copy to .env in the repo root and fill in. .env is git-ignored.

TELEGRAM_BOT_TOKEN=
NOTION_API_KEY=
OPENAI_API_KEY=

# Tool-calling agent for tagged messages and DMs. VAVA_AGENT=legacy uses the old router.
OPENAI_AGENT_MODEL=gpt-6-luna
VAVA_AGENT=tools
# Optional: OPENAI_AGENT_REASONING=low (none|low|medium|high), OPENAI_AGENT_API=responses (or chat)
