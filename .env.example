# Copy to .env in the repo root and fill in. .env is git-ignored.

TELEGRAM_BOT_TOKEN=
NOTION_API_KEY=
OPENAI_API_KEY=

# Main community group (morning recap + Notion announcements)
TELEGRAM_CHAT_ID=

# Optional separate ops groups (add bot to each; get ids with npm run telegram:chats)
# VOLUNTEERS_GROUP_CHAT_ID=
# MANAGEMENT_GROUP_CHAT_ID=
# GUESTS_GROUP_CHAT_ID=
# PROBLEM_ALERTS=false   # turn off instant problem alerts to Management
# Or map names in JSON:
# TELEGRAM_CHAT_ALIASES={"Vila Akoya Volunteers":"-100…","Vila Akoya Management":"-100…","Parents & Teachers":"-100…"}

# Tool-calling agent for tagged messages and DMs. VAVA_AGENT=legacy uses the old router.
OPENAI_AGENT_MODEL=gpt-6-luna
VAVA_AGENT=tools
# Optional: OPENAI_AGENT_REASONING=low (none|low|medium|high), OPENAI_AGENT_API=responses (or chat)

# "Bins are full" → email Câmara de Ourique (same SMTP as WP Mail SMTP on the site, or Resend)
# SMTP — same as WP Mail SMTP (Hostinger: SSL on 465)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@vila-akoya.com
SMTP_PASS=
COUNCIL_EMAIL=geral@cm-ourique.pt
COUNCIL_EMAIL_FROM=Sam Duarte-Davies <info@vila-akoya.com>
COUNCIL_EMAIL_REPLY_TO=samduarte-davies@hotmail.com
COUNCIL_EMAIL_CC=samduarte-davies@hotmail.com
# Optional: RESEND_API_KEY (fallback if SMTP_PASS unset), BINS_LOCATION_URL, COUNCIL_BINS_COOLDOWN_HOURS=48
