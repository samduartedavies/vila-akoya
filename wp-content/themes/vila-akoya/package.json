{
  "name": "vila-akoya-theme",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/app.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/app.css --watch",
    "start": "npm run start --prefix ../../..",
    "stop": "npm run stop --prefix ../../..",
    "clean": "npm run clean --prefix ../../.."
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "tailwindcss": "^3.4.17"
  }
}
