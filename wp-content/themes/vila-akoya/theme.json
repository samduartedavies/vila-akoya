{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "1280px",
			"wideSize": "1536px"
		},
		"color": {
			"palette": [
				{ "slug": "background", "color": "#fcf9ef", "name": "Background" },
				{ "slug": "surface", "color": "#fcf9ef", "name": "Surface" },
				{ "slug": "surface-warm", "color": "#fff6e1", "name": "Surface warm" },
				{ "slug": "primary", "color": "#9a4021", "name": "Primary" },
				{ "slug": "primary-container", "color": "#ba5737", "name": "Primary container" },
				{ "slug": "on-surface", "color": "#1c1c16", "name": "On surface" },
				{ "slug": "on-surface-variant", "color": "#56423c", "name": "On surface variant" },
				{ "slug": "secondary", "color": "#5c6348", "name": "Secondary" },
				{ "slug": "footer-bg", "color": "#2f3628", "name": "Footer background" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "\"Marcellus\", serif",
					"slug": "headline",
					"name": "Headline"
				},
				{
					"fontFamily": "\"Josefin Sans\", sans-serif",
					"slug": "body",
					"name": "Body"
				},
				{
					"fontFamily": "\"Barrio\", system-ui",
					"slug": "barrio",
					"name": "Barrio"
				}
			]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "1rem"
		},
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--on-surface)"
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
