{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1080px",
      "wideSize": "1440px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "primary",
          "color": "#9a3f21",
          "name": "Terracotta"
        },
        {
          "slug": "primary-container",
          "color": "#fb8965",
          "name": "Terracotta light"
        },
        {
          "slug": "secondary",
          "color": "#436250",
          "name": "Forest green"
        },
        {
          "slug": "secondary-container",
          "color": "#c7ebd4",
          "name": "Forest mint"
        },
        {
          "slug": "tertiary",
          "color": "#7a532a",
          "name": "Ochre"
        },
        {
          "slug": "tertiary-container",
          "color": "#d9a777",
          "name": "Ochre soft"
        },
        {
          "slug": "surface",
          "color": "#fff6e1",
          "name": "Warm sand"
        },
        {
          "slug": "surface-container",
          "color": "#f2e8cb",
          "name": "Sand container"
        },
        {
          "slug": "surface-container-low",
          "color": "#fbf0d5",
          "name": "Sand low"
        },
        {
          "slug": "surface-container-high",
          "color": "#ede2c3",
          "name": "Sand high"
        },
        {
          "slug": "surface-dim",
          "color": "#e0d4b2",
          "name": "Sand dim"
        },
        {
          "slug": "on-surface",
          "color": "#332e1e",
          "name": "Ink warm"
        },
        {
          "slug": "on-surface-variant",
          "color": "#625b48",
          "name": "Ink muted"
        },
        {
          "slug": "on-primary",
          "color": "#ffefeb",
          "name": "On terracotta"
        },
        {
          "slug": "on-secondary",
          "color": "#d7fbe3",
          "name": "On forest"
        },
        {
          "slug": "on-secondary-container",
          "color": "#395847",
          "name": "On forest mint"
        },
        {
          "slug": "outline-variant",
          "color": "#b5ad96",
          "name": "Outline soft"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "White"
        }
      ],
      "gradients": [
        {
          "slug": "primary-sun",
          "gradient": "linear-gradient(135deg, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--primary-container) 100%)",
          "name": "Terracotta sun"
        },
        {
          "slug": "hero-scrim",
          "gradient": "linear-gradient(180deg, rgba(51, 46, 30, 0) 0%, rgba(51, 46, 30, 0.45) 100%)",
          "name": "Hero scrim"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "fontFamily": "Barrio, ui-serif, Georgia, serif",
          "slug": "barrio",
          "name": "Barrio"
        },
        {
          "fontFamily": "\"Newsreader\", Georgia, \"Times New Roman\", serif",
          "slug": "newsreader",
          "name": "Newsreader"
        },
        {
          "fontFamily": "\"Plus Jakarta Sans\", system-ui, sans-serif",
          "slug": "plus-jakarta",
          "name": "Plus Jakarta Sans"
        },
        {
          "fontFamily": "\"Josefin Sans\", system-ui, sans-serif",
          "slug": "josefin",
          "name": "Josefin Sans"
        },
        {
          "fontFamily": "\"Marcellus\", Georgia, serif",
          "slug": "marcellus",
          "name": "Marcellus"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "1.0625rem",
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "1.25rem",
          "name": "Large"
        },
        {
          "slug": "x-large",
          "size": "1.5rem",
          "name": "Extra large"
        },
        {
          "slug": "xx-large",
          "size": "2rem",
          "name": "2X large"
        },
        {
          "slug": "display",
          "size": "clamp(2.5rem, 5vw, 3.5rem)",
          "name": "Display"
        },
        {
          "slug": "display-xl",
          "size": "clamp(3rem, 8vw, 5rem)",
          "name": "Display XL"
        }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "20", "size": "0.5rem", "name": "20" },
        { "slug": "30", "size": "0.75rem", "name": "30" },
        { "slug": "40", "size": "1rem", "name": "40" },
        { "slug": "50", "size": "1.25rem", "name": "50" },
        { "slug": "60", "size": "1.5rem", "name": "60" },
        { "slug": "70", "size": "2rem", "name": "70" },
        { "slug": "80", "size": "2.75rem", "name": "80" },
        { "slug": "90", "size": "4rem", "name": "90" },
        { "slug": "100", "size": "6rem", "name": "100" }
      ],
      "units": ["%", "px", "em", "rem", "vh", "vw"]
    },
    "border": {
      "radius": true
    },
    "shadow": {
      "presets": [
        {
          "name": "Editorial",
          "slug": "editorial",
          "shadow": "0 20px 40px rgba(51, 46, 30, 0.06)"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--surface)",
      "text": "var(--wp--preset--color--on-surface)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--josefin)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--70)"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--tertiary)"
          }
        }
      },
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--marcellus)",
          "fontWeight": "400",
          "lineHeight": "1.08",
          "fontSize": "clamp(2.4rem, 5vw, 4.7rem)"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--marcellus)",
          "fontWeight": "500",
          "lineHeight": "1.15",
          "fontSize": "var(--wp--preset--font-size--display)"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--marcellus)",
          "fontWeight": "500",
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--marcellus)",
          "fontWeight": "500",
          "fontSize": "var(--wp--preset--font-size--large)"
        }
      },
      "button": {
        "border": {
          "radius": "1.5rem",
          "width": "0",
          "style": "none"
        },
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--on-primary)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--josefin)",
          "fontSize": "var(--wp--preset--font-size--medium)",
          "fontWeight": "600"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary-container)",
            "text": "var(--wp--preset--color--on-primary)"
          }
        }
      }
    },
    "blocks": {
      "core/cover": {
        "spacing": {
          "padding": {
            "top": "0",
            "right": "0",
            "bottom": "0",
            "left": "0"
          }
        }
      },
      "core/group": {
        "spacing": {
          "blockGap": "var(--wp--preset--spacing--70)"
        }
      },
      "core/image": {
        "border": {
          "radius": "1rem"
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--barrio)",
          "fontWeight": "400",
          "lineHeight": "1.12"
        }
      },
      "core/post-content": {
        "spacing": {
          "blockGap": "var(--wp--preset--spacing--80)"
        }
      },
      "core/separator": {
        "color": {
          "background": "var(--wp--preset--color--outline-variant)"
        },
        "spacing": {
          "margin": {
            "top": "var(--wp--preset--spacing--80)",
            "bottom": "var(--wp--preset--spacing--80)"
          }
        }
      },
      "core/quote": {
        "border": {
          "left": {
            "color": "var(--wp--preset--color--tertiary)",
            "width": "4px",
            "style": "solid"
          }
        },
        "spacing": {
          "padding": {
            "left": "var(--wp--preset--spacing--60)"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-book",
      "title": "Book / inquire",
      "postTypes": ["page"]
    }
  ]
}
