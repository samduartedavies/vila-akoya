{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "min(100vw - 2rem, 1536px)"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "primary", "color": "#9a3f21", "name": "Primary" },
        { "slug": "primary-container", "color": "#fb8965", "name": "Primary container" },
        { "slug": "on-primary", "color": "#ffefeb", "name": "On primary" },
        { "slug": "secondary", "color": "#5c6348", "name": "Secondary" },
        { "slug": "secondary-container", "color": "#e2e6d8", "name": "Secondary container" },
        { "slug": "tertiary", "color": "#7a532a", "name": "Tertiary" },
        { "slug": "surface", "color": "#fff6e1", "name": "Surface" },
        { "slug": "surface-cream", "color": "#fcf9ef", "name": "Surface cream" },
        { "slug": "on-surface", "color": "#332e1e", "name": "On surface" },
        { "slug": "on-surface-variant", "color": "#625b48", "name": "On surface variant" },
        { "slug": "footer-bg", "color": "#2f3628", "name": "Footer background" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "\"Josefin Sans\", system-ui, sans-serif",
          "slug": "body",
          "name": "Body (copy)"
        },
        {
          "fontFamily": "Marcellus, Georgia, serif",
          "slug": "headline",
          "name": "Headline (H2–H3)"
        },
        {
          "fontFamily": "Barrio, system-ui, sans-serif",
          "slug": "barrio",
          "name": "Brand (H1)"
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1.125rem", "name": "Medium" },
        { "slug": "large", "size": "1.25rem", "name": "Large" },
        { "slug": "x-large", "size": "1.5rem", "name": "Extra large" },
        { "slug": "hero", "size": "clamp(2.5rem, 6vw, 5rem)", "name": "Hero" }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--surface)",
      "text": "var(--wp--preset--color--on-surface)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary-container)"
          }
        }
      },
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--barrio)",
          "fontSize": "var(--wp--preset--font-size--hero)",
          "lineHeight": "1.1"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--headline)",
          "fontWeight": "400"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--headline)"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
